# Copy to `.env` and fill in real values. Never commit `.env`.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database (set DJANGO_DB_ENGINE=sqlite for a quick local run)
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=onlineshop
DJANGO_DB_USER=onlineshop_admin
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# SMS (console = print OTP to the log, development only)
SMS_BACKEND=console
SMS_IR_API_KEY=
SMS_IR_LINE_NUMBER=
SMS_IR_TEMPLATE_ID=
SMS_IR_TEMPLATE_PARAM=CODE

# Zarinpal
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=True
ZARINPAL_CONNECT_TIMEOUT=5
ZARINPAL_READ_TIMEOUT=20

# Checkout / OTP
ORDER_RESERVATION_MINUTES=15
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# Optional independent JWT HMAC secret (minimum 32 characters in production).
# Defaults to DJANGO_SECRET_KEY when empty/unset; leave commented or set a random value.
# JWT_SIGNING_KEY=

# Shared cache and Celery (Compose overrides hosts to redis internally).
# CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
SMS_ASYNC=False
HEALTHCHECK_REQUIRE_WORKER=False
DJANGO_LOG_LEVEL=INFO
