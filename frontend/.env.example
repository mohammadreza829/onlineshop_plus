# Development only. Copy to .env.local; never commit real runtime secrets.
APP_ORIGIN=http://127.0.0.1:3000
DJANGO_ORIGIN=http://127.0.0.1:8000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BFF_COOKIE_SECRET=
# Required in production / multi-process; must be private/authenticated/TLS as appropriate.
BFF_REDIS_URL=
# Single-process development alternative ONLY; leave Redis URL empty first.
BFF_COORDINATION=memory
DJANGO_SESSION_COOKIE_NAME=sessionid
DJANGO_CSRF_COOKIE_NAME=csrftoken
# Match the actual Django gateway environment; exact HTTPS hostnames, no URLs.
PAYMENT_HOSTS=sandbox.zarinpal.com
# Optional explicit image CDN hosts, comma-separated. Local Django media uses bounded proxy.
PRODUCT_IMAGE_HOSTS=
# Set to the real HTTPS public domain only when known. No invented canonical domain.
SITE_URL=
# BFF_LOCAL_HTTP=1 is reserved for isolated production-build tests, NEVER public production.
